#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
# References Nikki's procd lifecycle; FII owns its own configuration and nft table.
# shellcheck disable=SC2034
START=99
STOP=10
USE_PROCD=1

start_service() {
    umask 077
    mkdir -p /tmp/fii /etc/fii/core
    /usr/bin/fii prepare > /tmp/fii/prepare.log 2>&1 || {
        logger -t fii-prepare < /tmp/fii/prepare.log
        return 1
    }
    procd_open_instance mihomo
    procd_set_param command /usr/libexec/fii/core-run
    procd_set_param file /etc/fii/active.json /tmp/fii/config.yaml
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 30
    procd_set_param limits nofile="65536 65536"
    procd_close_instance
}

stop_service() {
    /usr/bin/fii firewall-down
}

boot() {
    # Delay only the boot path; manual start stays immediate. The wait runs in
    # the background so a long delay cannot hold up the rest of the boot chain.
    local delay
    delay="$(/usr/bin/fii boot-delay 2>/dev/null)"
    case "$delay" in ''|*[!0-9]*) delay=0 ;; esac
    if [ "$delay" -gt 0 ]; then
        ( sleep "$delay"; start ) < /dev/null > /dev/null 2>&1 &
    else
        start
    fi
}

service_triggers() {
    procd_add_reload_interface_trigger "lan"
}

reload_service() {
    /etc/init.d/fii restart
}
