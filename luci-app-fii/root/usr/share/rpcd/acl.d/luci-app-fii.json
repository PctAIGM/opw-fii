{
  "luci-app-fii": {
    "description": "Manage FII subscriptions and Mihomo service",
    "read": {
      "cgi-io": ["download"],
      "file": { "/tmp/fii/transfers/*.out": ["read"] },
      "ubus": { "luci.fii": ["get", "status", "preview", "export", "logs", "job", "nodes", "groups", "resources", "url_test", "core_info", "core_check", "network", "transfer_read"] }
    },
    "write": {
      "cgi-io": ["upload"],
      "file": { "/tmp/fii/transfers/*.in": ["write"] },
      "ubus": { "luci.fii": ["save", "refresh", "apply", "service", "import", "import_preview", "select", "resource_update", "core_update", "core_channel", "transfer_begin", "transfer_append", "transfer_invoke", "transfer_release", "transfer_status"] }
    }
  }
}
